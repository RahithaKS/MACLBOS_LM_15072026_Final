kind = "web"
previewPath = "/standalone-boards/"
title = "LedgerLM Standalone Boards"
description = "Standalone LedgerLM Boards and Enterprise Data prototype."
version = "1.0.0"
id = "artifacts/ledgerlm-app"
router = "path"

[[services]]
name = "web"
paths = [ "/standalone-boards/" ]
localPort = 3000

[services.development]
run = "cd ../../ledgerlm/boards-standalone && npm run dev -- -H 0.0.0.0 -p 3000"

[services.production]
build = [ "pnpm", "--filter", "@workspace/ledgerlm-app", "run", "build" ]
serve = "static"
publicDir = "artifacts/ledgerlm-app/dist/public"

[[services.production.rewrites]]
from = "/*"
to = "/index.html"

[services.env]
PORT = "3000"
BASE_PATH = "/standalone-boards"